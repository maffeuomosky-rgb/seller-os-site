# Public application URL (no trailing slash)
PUBLIC_BASE_URL=https://seller-os-site-eight.vercel.app
SUPPORT_EMAIL=seller.os001@gmail.com

# Product / pricing
PRODUCT_NAME=Seller OS 1.1
PRODUCT_PRICE_CENTS=4900
PRODUCT_CURRENCY=EUR
PRODUCT_DOWNLOAD_DAYS=7
PRODUCT_MAX_DOWNLOADS=5

# PostgreSQL / Neon / compatible database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# PayPal — modalità link pubblico (attiva adesso)
PAYPAL_MODE=link
PAYPAL_PAYMENT_URL=https://paypal.me/USERNAME

# PayPal REST API — opzionale/futuro, non necessario in modalità link
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Bank transfer
BANK_ACCOUNT_NAME=
BANK_IBAN=

# Email via Resend
RESEND_API_KEY=
EMAIL_FROM=Seller OS <sender@dominio-verificato.it>

# Private product storage — Vercel Blob (recommended production)
BLOB_READ_WRITE_TOKEN=
PRODUCT_BLOB_PATHNAME=SELLER_OS_1.1_CUSTOMER_PACK_DEFINITIVO.zip

# Local-only product file fallback (do not use as public asset)
PRODUCT_FILE_PATH=/absolute/path/to/SELLER_OS_1.1_CUSTOMER_PACK_DEFINITIVO.zip

# Admin
ADMIN_SECRET=change-this-long-random-password
SESSION_SECRET=change-this-different-long-random-secret
ADMIN_SESSION_HOURS=8
